{
  "name": "SystemChrono",
  "version": "1.2.0",
  "description": "64-bit monotonic time helpers for Arduino and ESP-IDF. Uses esp_timer on ESP32/IDF and wrap-tracked micros() on generic Arduino. Provides micros64(), millis64(), seconds64(), elapsed timer classes, stopwatch, and allocation-free formatting.",
  "keywords": [
    "timer",
    "time",
    "micros",
    "millis",
    "seconds",
    "elapsed",
    "stopwatch",
    "64-bit",
    "esp32",
    "esp-idf",
    "arduino",
    "non-blocking"
  ],
  "authors": [
    {
      "name": "Jan Havelka",
      "email": "info@thymos.cz",
      "url": "https://www.thymos.cz",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/janhavelka/SystemChrono.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/janhavelka/SystemChrono",
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "platforms": [
    "espressif32",
    "*"
  ],
  "headers": [
    "SystemChrono/SystemChrono.h"
  ],
  "build": {
    "includeDir": "include",
    "srcDir": "src"
  }
}
